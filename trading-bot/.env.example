# Exchange API credentials
# Supports: bybit, binance, okx
EXCHANGE=bybit

# API keys - use testnet keys for testing
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Set to true to use exchange testnet (STRONGLY recommended first)
USE_TESTNET=true

# Trading parameters
SYMBOL=POPCAT/USDT:USDT
LEVERAGE=10
TIMEFRAME=15m

# Risk per trade as % of account balance
RISK_PERCENT=1.0

# Strategy: rsi_macd or breakout
STRATEGY=rsi_macd
