# Required: the password you use to log in to the dashboard.
APP_PASSWORD=change-me-to-something-long

# Optional: random string used to sign login cookies (defaults to one derived from APP_PASSWORD).
SESSION_SECRET=

# Optional: a Solana RPC URL. The free public one works but is slow and rate limited.
# A free Helius / QuickNode / Alchemy key makes wallet profiling much faster.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Requests per second allowed to the RPC (public RPC: keep at 3-4).
SOLANA_RPC_RPS=3

PORT=8080
# Where the SQLite database lives. Use a persistent disk when hosting.
DATA_DIR=./data
